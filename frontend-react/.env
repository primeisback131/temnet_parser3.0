# Base path of the backend API.
# Relative (/api) means "same origin": the Vite dev server proxies it to
# http://localhost:8080 (see vite.config.ts) and a reverse proxy does the same
# in production, so cookies and CSRF need no cross-site setup. Set an absolute
# URL only when the API is served from another host; the backend then also
# needs CORS_ORIGIN.
VITE_API_BASE=/api
